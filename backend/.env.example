APP_ENV=development
SECRET_KEY=
DATABASE_URL=sqlite+aiosqlite:///./pestguard.db
REDIS_URL=redis://127.0.0.1:6379/0
MODEL_PATH=
ALLOW_MOCK_DETECTOR=true
CORS_ORIGINS=http://localhost:5173
MAX_IMAGE_BYTES=10485760
MAX_VIDEO_BYTES=104857600
UPLOAD_DIR=./data/uploads
RESULT_DIR=./data/results
# DeepSeek 二次解读（可选）：API_KEY 留空则自动关闭，不影响 YOLO 主流程
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
IMAGE_CONCURRENCY=2
IMAGE_QUEUE_SIZE=8
IMAGE_QUEUE_TIMEOUT_SECONDS=15
ANALYSIS_QUEUE_NAME=arq:analysis

