[Unit]
Description=PestGuard TLS/HTTP single-port proxy (8000 -> 8001)
After=network.target pestguard.service
Wants=pestguard.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/pestguard/tools/tls_proxy.py
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
